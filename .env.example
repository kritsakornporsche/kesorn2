# Copy to .env.local and fill in. Names only — never commit real values.

# Database (MySQL / MariaDB)
DATABASE_URL=mysql://user:password@localhost:3306/kesorn_db

# Auth.js
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Timed notifications (lib/reminders.ts): the scheduler calls POST /api/cron/reminders with
#   Authorization: Bearer <CRON_SECRET>   (e.g. hourly from crontab or PM2). Empty = the cron route answers 401;
# reminders still run from page loads (GET /api/notifications, at most every 10 minutes).
CRON_SECRET=

# Slip checking (SlipOK) — required: no built-in fallback (commit 26c); empty = slips are refused with a clear message
SLIPOK_API_KEY=
SLIPOK_ENDPOINT=

# AI meter reading only (a key set on /owner/settings is used first) — ID card OCR was removed (commit 24c)
GEMINI_API_KEY=

# Sign-up protection and e-mail
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_MAIL_WORKER_URL=
CLOUDFLARE_MAIL_API_KEY=

# Social sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
